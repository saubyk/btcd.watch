[Unit]
Description=btcd sync-peer stall watchdog (one tick; scheduled by the .timer)
After=btcd.service
# Not Requires=: if btcd is down the script just reports the RPC failure.

[Service]
Type=oneshot
# Must be a user whose btcctl can reach the node's RPC. With the layout in
# deploy/README.md that is the btcd user plus a btcctl.conf under /etc/btcd;
# on a host where btcd runs as a login user with ~/.btcctl/btcctl.conf, set
# User= to that user and make BTCCTL just the binary. Units do not read shell
# profiles: if btcctl is not on the system PATH (e.g. it lives in ~/go/bin),
# BTCCTL must be an absolute path.
User=btcd
Group=btcd
Environment="BTCCTL=btcctl --configfile=/etc/btcd/btcctl.conf"
ExecStart=/usr/local/bin/btcd-sync-watchdog.sh
# /var/lib/btcd-sync-watchdog: state file + interventions.log
StateDirectory=btcd-sync-watchdog
SyslogIdentifier=btcd-sync-watchdog

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
